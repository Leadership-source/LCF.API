generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String         @id @default(uuid())
  name                     String
  email                    String         @unique
  password                 String
  createdAT                DateTime       @default(now())
  resetPasswordToken       String?
  resetPasswordTokenExpiry DateTime?
  adminLoginCodeHash       String?
  adminLoginCodeExpiry     DateTime?
  adminLoginChallenge      String?  @unique
  role                     Role           @default(USER)
  events                   Event[]
  notifications            Notification[]
  teams                    Team[]
  externalRoles           ExternalRole[]
  testimonials             Testimonial[]
}

model Team {
  id           String     @id @default(uuid())
  name         String
  role         String
  bio          String?
  image        String
  createdBy    String
  displayOrder Int        @default(0)
  status       TeamStatus @default(UNPUBLISHED)
  creator      User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

model ExternalRole {
  id           String     @id @default(uuid())
  name         String
  roleType     String     // ADVISOR, PATRON, BRAND_AMBASSADOR, HONORARY_SUPPORTER, MENTEE
  bio          String?
  image        String
  displayOrder Int        @default(0)
  status       String     @default("UNPUBLISHED")
  createdBy    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  creator      User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([roleType])
}

model Event {
  id            String              @id @default(uuid())
  category      String
  title         String
  image         String
  location      String
  date          DateTime
  time          String
  description   String
  speaker       String
  venue         String
  attendees     Int
  agenda        String[]
  createdAt     DateTime            @default(now())
  createdBy     String
  status        EventStatus         @default(UNPUBLISHED)
  creator       User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VolunteerApplication {
  id              String   @id @default(uuid())
  fullName        String
  email           String
  phone           String?
  areaOfInterest  String
  availability    String
  details         Json
  message         String?
  status          String   @default("NEW")
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  name         String
  email        String
  phone        String?
  registeredAt DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
}

model Testimonial {
  id         String            @id @default(uuid())
  name       String
  role       String
  message    String
  status     TestimonialStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  approvedAt DateTime?
  approvedBy String?
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model NewsArticle {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  date        DateTime
  readTime    String?
  image       String
  excerpt     String
  content     String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



model LeaderQuote {
  id          String      @id @default(uuid())
  name        String
  role        String
  email       String?
  quote       String      @db.Text
  image       String?
  status      QuoteStatus @default(DRAFT)
  source      QuoteSource @default(ADMIN)
  createdBy   String?
  reviewedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model QuoteInvitation {
  id          String   @id @default(uuid())
  email       String
  token       String   @unique

  expiresAt   DateTime
  usedAt      DateTime?
  cancelledAt DateTime?

  createdAt   DateTime @default(now())
  createdBy   String

  @@index([email])
  @@index([expiresAt])
}

model Partner {
  id        String        @id @default(uuid())
  name      String
  logo      String?
  status    PartnerStatus @default(UNPUBLISHED)
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum PartnerStatus {
  PUBLISHED
  UNPUBLISHED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  PUBLISHED
  UNPUBLISHED
}

enum TeamStatus {
  PUBLISHED
  UNPUBLISHED
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum QuoteStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum QuoteSource {
  ADMIN
  INVITATION
}